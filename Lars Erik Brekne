    <script>
        // Funksjon for å bytte mellom meny-seksjonar
        function showSection(sectionId, element) {
            // Skjul alle seksjonar
            var sections = document.querySelectorAll('.section');
            sections.forEach(function(sec) {
                sec.classList.remove('active');
            });
            // Fjerne active klasse frå alle meny-item
            var menuItems = document.querySelectorAll('.menu-item');
            menuItems.forEach(function(item) {
                item.classList.remove('active');
            });
            document.getElementById(sectionId).classList.add('active');
            element.classList.add('active');
        }
        
        // Funksjon for å bytte mellom familie-innhald
        function showFamily(familyId, element) {
            // Skjul alle familie-innhald
            var families = document.querySelectorAll('.family-content');
            families.forEach(function(fam) {
                fam.classList.remove('active');
            });
            // Fjerne active klasse frå alle familie-knappar
            var buttons = document.querySelectorAll('.family-button');
            buttons.forEach(function(btn) {
                btn.classList.remove('active');
            });
            document.getElementById(familyId).classList.add('active');
            element.classList.add('active');
        }
    </script>
